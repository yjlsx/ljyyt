  paginationHTML += '<div class="ms-3 d-flex align-items-center gap-2">' +
                      '<input type="number" id="jump-video-page-input" class="form-control form-control-sm" style="width: 60px;" min="1" max="' + totalPages + '" value="' + videoCurrentPage + '">' +
