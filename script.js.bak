  }
  
  for (let i = startPage; i <= endPage; i++) {
    paginationHTML += '<button class="btn btn-sm ' + (i === videoCurrentPage ? 'btn-primary' : 'btn-outline-primary') + ' page-btn" onclick="changeVideoPage(' + i + ')">' + i + '</button>';
  }
  
  if (endPage < totalPages) {
